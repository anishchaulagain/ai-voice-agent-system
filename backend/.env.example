# --- Provider selection ---
# Which provider to use for each stage. Options: openai | groq | edge (TTS only)
STT_PROVIDER=openai
LLM_PROVIDER=openai
TTS_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_STT_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# --- Groq (OpenAI-compatible endpoint) ---
GROQ_API_KEY=gsk_...
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_TTS_MODEL=playai-tts
GROQ_TTS_VOICE=Celeste-PlayAI

# --- ElevenLabs (TTS only, human-grade voices) ---
ELEVENLABS_API_KEY=
# Default: "Sarah" — soft, professional US female; works on free tier. Most library voices
# (Rachel/Aria/Charlotte) require a paid plan. Free-tier alternatives: Matilda XrExE9yKIg1WjnnlVkGX,
# Jessica cgSgspJ2msm6clMCkdW9, Laura FGY2WhTYpPnrIDTdsKH5, River SAz9YHcvj6GT2YYXdXww.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_turbo_v2_5

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
